# Copy this file to `.env` and fill it in. Only the AI provider you use needs its settings.
#
# Most of these can also be changed later on the app's Settings page. A value saved there
# overrides the one here until you click "Use the .env value instead".
# API keys and EMAIL_PASSWORD can only be set in this file.

# ---- AI provider: ollama (local), openai or claude ----
LLM_SERVICE=ollama

# Ollama on this machine. host.docker.internal reaches the host from inside the container.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
# Context window in tokens. Larger needs more GPU memory.
OLLAMA_NUM_CTX=16384

# OpenAI, or any OpenAI-compatible server. Leave OPENAI_BASE_URL empty for OpenAI itself.
# Examples: LM Studio  http://host.docker.internal:1234/v1
#           OpenRouter https://openrouter.ai/api/v1
#           vLLM / LiteLLM / llama.cpp server: http://<host>:<port>/v1
# Local servers usually need no key; hosted services do.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Claude, or any Anthropic-compatible gateway/proxy. Leave ANTHROPIC_BASE_URL empty for Anthropic's API.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max (more effort = slower and more tokens)
CLAUDE_EFFORT=low

# ---- Email digests ----
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
EMAIL_USER=
# Gmail: use an App Password (Google account > Security > App passwords), not your normal password
EMAIL_PASSWORD=
FROM_EMAIL=
# Used for the "Manage subscriptions" link in emails
APP_URL=http://localhost:8090

# ---- Schedule ----
TIMEZONE=America/New_York
# One or more local times, comma-separated, e.g. 07:30,18:00
SCHEDULE_TIMES=09:00

# ---- Optional ----
APP_PORT=8090
# Characters of transcript sent to the AI per video (20000 is about 25 minutes of speech).
# More covers long videos better but costs more; Ollama also needs a larger OLLAMA_NUM_CTX.
TRANSCRIPT_MAX_CHARS=20000
# Each email lists EVERY new video. This many of the newest per channel also get an AI summary.
# 0 = no AI summaries (videos are still listed, with their descriptions).
MAX_AI_SUMMARIES_PER_CHANNEL=3
